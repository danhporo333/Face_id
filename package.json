{
  "name": "backend",
  "version": "1.0.0",
  "description": "dự án điểm danh bằng face_id",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon",
    "dev": "nodemon",
    "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/app.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "node_modules"
    ],
    "exec": "ts-node -r tsconfig-paths/register ./src/app.ts"
  },
  "keywords": [
    "nodejs",
    "with",
    "typescript"
  ],
  "author": "danh",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.3.0",
    "bcrypt": "^5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.0.1",
    "express-fileupload": "^1.5.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "3.12.0"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "22.10.7",
    "nodemon": "3.1.9",
    "prisma": "6.3.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  }
}
